{
  "about": "Which requirement each test group proves (docs/requirements.md) and which student feature it needs. Core groups always run. Feature groups run only when project.json lists their feature; 'a+b' needs both. A test matching no group still runs, with a note to add it here. Groups match test names by regular expression.",
  "features": {
    "google": "Uses Gmail and Google Calendar",
    "microsoft": "Uses Outlook mail and calendar through the local Microsoft server",
    "tasks-builtin": "Tasks are kept in Command Center itself",
    "microsoft-todo": "Tasks are kept in Microsoft To Do",
    "org": "Belongs to a student organization (chapter, club) with its own calendar or updates",
    "lms": "Has a class-deadline calendar (Canvas or similar)",
    "notebooklm": "Uses NotebookLM notebooks for classes",
    "plan-with-claude": "Uses Plan with Claude and the agent queue",
    "desktop-app": "Installs Command Center as a desktop app",
    "phone": "Uses Command Center on a phone"
  },
